# Footage Finder Configuration (.env)

# API Keys
GEMINI_API_KEY=
SERPER_API_KEY=
YOUTUBE_API_KEY=

# Gemini Models (default to current flash tier model)
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_VISION_MODEL=gemini-3.8-flash

# Tunables
CANDIDATES_PER_SEGMENT=15
TOP_PICKS=3
MAX_ALTERNATES=5
MIN_WIDTH_GENERAL=1280
MIN_WIDTH_ARCHIVAL=600
PREFER_ASPECT=16:9
MIN_SCORE=6.0

# Rate Limiting & Concurrency
CONCURRENT_SEARCH_LIMIT=4
CONCURRENT_DOWNLOAD_LIMIT=6
REQUEST_TIMEOUT_SECONDS=15.0

# Wikimedia User Agent (policy requires tool name and contact info)
WIKIMEDIA_USER_AGENT=FootageFinder/1.0 (https://github.com/yourusername/Footage-Finder; contact@footagefinder.app)

# Cache TTL (in hours)
SEARCH_CACHE_TTL_HOURS=72
